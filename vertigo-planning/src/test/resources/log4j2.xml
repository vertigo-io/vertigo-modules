<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{HH:mm:ss} [%t] %-5p %-11c{1} - %m %x %n" />
		</Console>
	</Appenders>

	<!-- UI tests of the planning demo : warnings and errors only (the errors of a request are logged by vertigo-ui) -->
	<Loggers>
		<Root level="warn">
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>
